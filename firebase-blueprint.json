{
  "entities": {
    "Notice": {
      "title": "Notice",
      "description": "Departmental notices and announcements",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "type", "createdAt"]
    },
    "BreakingNews": {
      "title": "Breaking News",
      "description": "Ticker items for the top of the dashboard",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "priority": { "type": "number" }
      },
      "required": ["text"]
    },
    "Project": {
      "title": "Innovation Hub Project",
      "description": "Research and development projects",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "team": { "type": "string" },
        "status": { "type": "string", "enum": ["In Progress", "Completed", "Beta"] }
      },
      "required": ["title", "team", "status"]
    },
    "LeaderboardEntry": {
      "title": "Student Leaderboard Entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "number" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "name", "score", "avatar"]
    },
    "Distribution": {
      "title": "Student Distribution",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "value": { "type": "number" }
      },
      "required": ["category", "value"]
    },
    "Placement": {
      "title": "Alumni Placement",
      "type": "object",
      "properties": {
        "company": { "type": "string" },
        "student": { "type": "string" },
        "logo": { "type": "string" }
      },
      "required": ["company", "student", "logo"]
    },
    "Stats": {
      "title": "Dashboard Stats",
      "description": "Overall department statistics",
      "type": "object",
      "properties": {
        "totalStudents": { "type": "number" },
        "activeStudents": { "type": "number" },
        "alumni": { "type": "number" },
        "placementRate": { "type": "number" },
        "performanceIndex": { "type": "number" }
      },
      "required": ["totalStudents", "activeStudents", "alumni", "placementRate", "performanceIndex"]
    }
  },
  "firestore": {
    "/notices/{id}": { "schema": "Notice", "description": "Notice Board" },
    "/news/{id}": { "schema": "BreakingNews", "description": "Ticker text" },
    "/innovation/{id}": { "schema": "Project", "description": "Innovation Hub" },
    "/leaderboard/{id}": { "schema": "LeaderboardEntry", "description": "Top students" },
    "/distribution/{id}": { "schema": "Distribution", "description": "Student split data" },
    "/placements/{id}": { "schema": "Placement", "description": "Alumni placements" },
    "/settings/stats": { "schema": "Stats", "description": "Global counters" }
  }
}
