{
  "entities": {
    "Notice": {
      "title": "Notice",
      "description": "Departmental notices and announcements",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "type", "createdAt"]
    },
    "BreakingNews": {
      "title": "Breaking News",
      "description": "Ticker items for the top of the dashboard",
      "type": "object",
      "properties": {
        "text": { "type": "string" }
      },
      "required": ["text"]
    },
    "Project": {
      "title": "Innovation Hub Project",
      "description": "Research and development projects",
      "type": "object",
      "properties": {
        "title": { "type": "string" }
      },
      "required": ["title"]
    },
    "LeaderboardEntry": {
      "title": "Student Leaderboard Entry",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "batch": { "type": "string" },
        "score": { "type": "number" },
        "avatar": { "type": "string" }
      },
      "required": ["name", "batch", "score", "avatar"]
    },
    "Placement": {
      "title": "Alumni Placement",
      "description": "Placement records showing success of students",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "company": { "type": "string" },
        "position": { "type": "string" },
        "year": { "type": "string" }
      },
      "required": ["name", "company", "position", "year"]
    },
    "BroadcastSettings": {
      "title": "Broadcast Settings",
      "description": "Defines the video source or image source and the current rendering choice",
      "type": "object",
      "properties": {
        "mediaType": { "type": "string", "enum": ["video", "image"] },
        "videoSrc": { "type": "string" },
        "imageSrc": { "type": "string" }
      },
      "required": ["mediaType", "videoSrc", "imageSrc"]
    },
    "ContactSettings": {
      "title": "Quick Contact Settings",
      "description": "Admin editable contact details for head of department and chief instructor",
      "type": "object",
      "properties": {
        "headName": { "type": "string" },
        "headPhone": { "type": "string" },
        "headEmail": { "type": "string" },
        "ciName": { "type": "string" },
        "ciPhone": { "type": "string" },
        "ciEmail": { "type": "string" }
      },
      "required": ["headName", "headPhone", "headEmail", "ciName", "ciPhone", "ciEmail"]
    },
    "Stats": {
      "title": "Dashboard Stats",
      "description": "Overall department statistics",
      "type": "object",
      "properties": {
        "totalStudents": { "type": "number" },
        "activeStudents": { "type": "number" },
        "alumni": { "type": "number" },
        "placementRate": { "type": "number" },
        "performanceIndex": { "type": "number" }
      },
      "required": ["totalStudents", "activeStudents", "alumni", "placementRate", "performanceIndex"]
    }
  },
  "firestore": {
    "/notices/{id}": { "schema": "Notice", "description": "Notice Board" },
    "/news/{id}": { "schema": "BreakingNews", "description": "Ticker text" },
    "/innovation/{id}": { "schema": "Project", "description": "Innovation Hub" },
    "/leaderboard/{id}": { "schema": "LeaderboardEntry", "description": "Top students" },
    "/placements/{id}": { "schema": "Placement", "description": "Alumni placements" },
    "/settings/stats": { "schema": "Stats", "description": "Global counters" },
    "/settings/broadcast": { "schema": "BroadcastSettings", "description": "Broadcast options" },
    "/settings/contact": { "schema": "ContactSettings", "description": "Quick contacts" }
  }
}
