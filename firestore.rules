rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && 
             (request.auth.token.email == 'rakib.47g@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidNotice(data) {
      return data.keys().hasAll(['text', 'type', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.text is string && data.text.size() <= 1000 &&
             data.type in ['info', 'warning'] &&
             data.createdAt == request.time;
    }

    function isValidNews(data) {
      return data.keys().hasAll(['text', 'priority']) &&
             data.text is string && data.text.size() <= 200 &&
             data.priority is number;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'team', 'status']) &&
             data.title is string && data.title.size() <= 100 &&
             data.team is string && data.team.size() <= 100 &&
             data.status in ['In Progress', 'Completed', 'Beta'];
    }

    function isValidLeaderboard(data) {
      return data.keys().hasAll(['id', 'name', 'score', 'avatar']) &&
             data.id is string && data.name is string &&
             data.score is number && data.avatar is string;
    }

    function isValidDistribution(data) {
      return data.keys().hasAll(['category', 'value']) &&
             data.category is string && data.value is number;
    }

    function isValidPlacement(data) {
      return data.keys().hasAll(['company', 'student', 'logo']) &&
             data.company is string && data.student is string && data.logo is string;
    }

    function isValidStats(data) {
      return data.keys().hasAll(['totalStudents', 'activeStudents', 'alumni', 'placementRate', 'performanceIndex']) &&
             data.totalStudents is number && data.activeStudents is number &&
             data.alumni is number && data.placementRate is number &&
             data.performanceIndex is number;
    }

    // --- Collection Matches ---

    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidNotice(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidNews(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /innovation/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidProject(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /leaderboard/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidLeaderboard(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /distribution/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidDistribution(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /placements/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidPlacement(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /settings/stats {
      allow read: if true;
      allow write: if isAdmin() && isValidStats(incoming());
    }

  }
}
