rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && 
             (request.auth.token.email == 'rakib.47g@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidNotice(data) {
      return data.keys().hasAll(['text', 'type', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.text is string && data.text.size() <= 1000 &&
             data.type in ['info', 'warning'] &&
             data.createdAt == request.time;
    }

    function isValidNews(data) {
      return data.keys().hasAll(['text', 'createdAt']) &&
             data.keys().size() == 2 &&
             data.text is string && data.text.size() <= 1000 &&
             data.createdAt == request.time;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'createdAt']) &&
             data.keys().size() == 2 &&
             data.title is string && data.title.size() <= 200 &&
             data.createdAt == request.time;
    }

    function isValidLeaderboard(data) {
      return data.keys().hasAll(['name', 'batch', 'score', 'avatar', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.name is string && data.name.size() <= 100 &&
             data.batch is string && data.batch.size() <= 100 &&
             data.score is number && 
             data.avatar is string && data.avatar.size() <= 20 &&
             data.createdAt == request.time;
    }

    function isValidPlacement(data) {
      return data.keys().hasAll(['name', 'company', 'position', 'year', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.name is string && data.name.size() <= 100 &&
             data.company is string && data.company.size() <= 100 &&
             data.position is string && data.position.size() <= 100 &&
             data.year is string && data.year.size() <= 50 &&
             data.createdAt == request.time;
    }

    function isValidStats(data) {
      return data.keys().hasAll(['totalStudents', 'activeStudents', 'alumni', 'placementRate', 'performanceIndex']) &&
             data.keys().size() == 5 &&
             data.totalStudents is number && data.activeStudents is number &&
             data.alumni is number && data.placementRate is number &&
             data.performanceIndex is number;
    }

    function isValidBroadcast(data) {
      return data.keys().hasAll(['mediaType', 'videoSrc', 'imageSrc']) &&
             data.keys().size() == 3 &&
             data.mediaType in ['video', 'image'] &&
             data.videoSrc is string && data.videoSrc.size() <= 1000 &&
             data.imageSrc is string && data.imageSrc.size() <= 1000;
    }

    function isValidContact(data) {
      return data.keys().hasAll(['headName', 'headPhone', 'headEmail', 'ciName', 'ciPhone', 'ciEmail']) &&
             data.keys().size() == 6 &&
             data.headName is string && data.headName.size() <= 100 &&
             data.headPhone is string && data.headPhone.size() <= 50 &&
             data.headEmail is string && data.headEmail.size() <= 100 &&
             data.ciName is string && data.ciName.size() <= 100 &&
             data.ciPhone is string && data.ciPhone.size() <= 50 &&
             data.ciEmail is string && data.ciEmail.size() <= 100;
    }

    // --- Collection Matches ---

    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidNotice(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidNews(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /innovation/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidProject(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /leaderboard/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidLeaderboard(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /placements/{id} {
      allow read: if true;
      allow write: if isAdmin() && isValidPlacement(incoming()) && isValidId(id);
      allow delete: if isAdmin();
    }

    match /settings/stats {
      allow read: if true;
      allow write: if isAdmin() && isValidStats(incoming());
    }

    match /settings/broadcast {
      allow read: if true;
      allow write: if isAdmin() && isValidBroadcast(incoming());
    }

    match /settings/contact {
      allow read: if true;
      allow write: if isAdmin() && isValidContact(incoming());
    }

  }
}
